# SPHERExLens Node.js Portal Environment Variables
# Copy to .env if overriding defaults locally.

# Server bind port (AI Studio uses 3000)
PORT=3000

# Upstream Cloud Run APIs (defaults point to the public SPHERExLens services)
SPHEREX_SNAPSHOT_API=https://spherex-lens-api-m6cqoypnxa-uc.a.run.app/api
SPHEREX_LIVE_API=https://spherex-lens-live-m6cqoypnxa-uc.a.run.app/api

# Optional local fallback asset directories
SPHEREX_EVAL_DIR=eval
SPHEREX_ML_MODEL_DIR=ml/models

# Optional comma-separated allowed CORS origins
SPHEREX_CORS_ORIGINS=

# Optional operator token forwarded when triggering /api/refresh
SPHEREX_REFRESH_OPERATOR_TOKEN=
